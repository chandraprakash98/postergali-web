              "path": ["jobs"],
              "query": [
                { "key": "latitude", "value": "{{lat}}" },
                { "key": "longitude", "value": "{{lng}}" },
                { "key": "radius", "value": "10" },
                { "key": "job_type", "value": "full_time" },
                { "key": "is_expiry", "value": "within_3_days" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
