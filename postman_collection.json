              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 422', function () { pm.response.to.have.status(422); });",
                  "pm.test('Error message identifies unsupported parameter', function () { const json = pm.response.json(); pm.expect(json.success).to.be.false; pm.expect(json.errors.filters).to.exist; });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Jobs - Reject Invalid Expiry Format (Negative Test)",
