    {
      "name": "4. Exception Handling & Security",
      "item": [
        {
          "name": "GET 404 Resource Not Found",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs/99999999",
              "host": ["{{base_url}}"],
              "path": ["jobs", "99999999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404', function () { pm.response.to.have.status(404); });",
                  "pm.test('Consistent error payload', function () { const json = pm.response.json(); pm.expect(json.success).to.be.false; pm.expect(json.message).to.eql('Resource not found.'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
