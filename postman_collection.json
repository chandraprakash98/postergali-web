  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "lat",
      "value": "28.5914",
      "type": "string"
    },
    {
      "key": "lng",
      "value": "77.4021",
      "type": "string"
    }
