  "item": [
    {
      "name": "1. Job Filtering",
      "item": [
        {
          "name": "GET Nearby Jobs - Default (5km)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs?latitude={{lat}}&longitude={{lng}}&radius=5",
              "host": ["{{base_url}}"],
              "path": ["jobs"],
              "query": [
                { "key": "latitude", "value": "{{lat}}" },
                { "key": "longitude", "value": "{{lng}}" },
                { "key": "radius", "value": "5" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response structure is valid', function () { const json = pm.response.json(); pm.expect(json.success).to.be.true; pm.expect(json.data).to.be.an('array'); pm.expect(json.pagination).to.be.an('object'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Jobs - Filter by Subcategory and Salary (<10,000)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs?latitude={{lat}}&longitude={{lng}}&radius=15&sub_categories=food&salary=less_than_10000",
              "host": ["{{base_url}}"],
              "path": ["jobs"],
              "query": [
                { "key": "latitude", "value": "{{lat}}" },
                { "key": "longitude", "value": "{{lng}}" },
                { "key": "radius", "value": "15" },
                { "key": "sub_categories", "value": "food" },
                { "key": "salary", "value": "less_than_10000" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Filtered results match salary criteria', function () { const json = pm.response.json(); json.data.forEach(item => pm.expect(item.salary).to.be.at.most(9999)); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
